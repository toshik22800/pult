<UserControl x:Class="Pult.Views.SimpleHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <StackPanel Margin="28,24,28,32">
            <TextBlock Text="Главная" FontFamily="{DynamicResource F_Ui}"
                       FontSize="24" Foreground="{DynamicResource B_Accent}"/>

            <!-- Пульс: здоровье одним числом + история -->
            <Grid Margin="0,16,0,0">
                <Border x:Name="PulseGlowFrame" Background="Transparent"
                        BorderBrush="{DynamicResource B_Border}" BorderThickness="2"
                        IsHitTestVisible="False"/>
                <Border x:Name="PulseCard" Style="{StaticResource SimpleActionCard}"
                    Background="{DynamicResource B_Card}"
                    BorderBrush="{DynamicResource B_Border}" BorderThickness="2"
                    Padding="0" Margin="0" Cursor="Hand"
                    MouseLeftButtonUp="Pulse_Click"
                    ToolTip="Что входит в оценку — кликни.">
                <Grid Margin="28,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock x:Name="PulseScore" Text="…" RenderTransformOrigin="0.5,0.5"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="56"
                                   Foreground="{DynamicResource B_Text}"
                                   HorizontalAlignment="Center"/>
                        <!-- 🆕 0.14.3: кардиограмма убрана как «техно-деталь»
                             (простому юзеру она ничего не говорит) -->
                        <Polyline x:Name="PulseSpark" Width="120" Height="36"
                                  Stroke="{DynamicResource B_Accent}" StrokeThickness="2"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PulseStatus" Text="Считаю…"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="15"
                                   Foreground="{DynamicResource B_Text}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PulseSub" Text="" FontSize="13"
                                   Foreground="{DynamicResource B_Dim}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Умная проверка одним кликом -->
            </Grid>
            <Border x:Name="SmartCard" Style="{StaticResource SimpleActionCard}" Margin="0,16,0,0" Height="110"
                    Padding="26,22" Cursor="Hand" MouseLeftButtonUp="Smart_Click"
                    ToolTip="Сам проверю диск, мусор и обновления, потом предложу исправить.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                    <Border Background="{DynamicResource B_Soft}" CornerRadius="16" Width="60" Height="60">
                        <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                   Foreground="{DynamicResource B_Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Проверить всё" FontFamily="{DynamicResource F_Ui}" FontSize="17"
                                   Foreground="{DynamicResource B_Text}"/>
                        <TextBlock Text="Сам найду мусор и обновления, потом спрошу" FontSize="13"
                                   Foreground="{DynamicResource B_Dim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Четыре большие кнопки -->
            <UniformGrid Columns="2" Margin="0,16,0,0">
                <Border Style="{StaticResource SimpleActionCard}" Margin="0,0,10,10" Height="200"
                        Padding="26,24"
                        x:Name="CardJunk" Cursor="Hand" MouseLeftButtonUp="Junk_Click"
                        ToolTip="Посмотрю временные файлы и предложу убрать.">
                    <StackPanel VerticalAlignment="Center" Margin="0">
                        <Border Background="{DynamicResource B_Soft}" CornerRadius="16" Width="60" Height="60"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                       Foreground="{DynamicResource B_Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Убрать мусор" FontFamily="{DynamicResource F_Ui}" FontSize="17"
                                   Foreground="{DynamicResource B_Text}" Margin="0,14,0,0"/>
                        <TextBlock Text="Временные файлы старше суток" FontSize="13"
                                   Foreground="{DynamicResource B_Dim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SimpleActionCard}" Margin="10,0,0,10" Height="200"
                        Padding="26,24"
                        x:Name="CardSpace" Cursor="Hand" MouseLeftButtonUp="Space_Click"
                        ToolTip="Покажу, сколько свободно на дисках, и почищу.">
                    <StackPanel VerticalAlignment="Center" Margin="0">
                        <Border Background="{DynamicResource B_Soft}" CornerRadius="16" Width="60" Height="60"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                       Foreground="{DynamicResource B_Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Освободить место" FontFamily="{DynamicResource F_Ui}" FontSize="17"
                                   Foreground="{DynamicResource B_Text}" Margin="0,14,0,0"/>
                        <TextBlock Text="Сколько свободно и чистка" FontSize="13"
                                   Foreground="{DynamicResource B_Dim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SimpleActionCard}" Margin="0,10,10,0" Height="200"
                        Padding="26,24"
                        x:Name="CardDupes" Cursor="Hand" MouseLeftButtonUp="Dupes_Click"
                        ToolTip="Найду одинаковые файлы в Загрузках.">
                    <StackPanel VerticalAlignment="Center" Margin="0">
                        <Border Background="{DynamicResource B_Soft}" CornerRadius="16" Width="60" Height="60"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                       Foreground="{DynamicResource B_Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Найти повторы" FontFamily="{DynamicResource F_Ui}" FontSize="17"
                                   Foreground="{DynamicResource B_Text}" Margin="0,14,0,0"/>
                        <TextBlock Text="Одинаковые файлы в Загрузках" FontSize="13"
                                   Foreground="{DynamicResource B_Dim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
    <Border x:Name="CardRecycle" Style="{StaticResource SimpleActionCard}" Margin="10,10,0,0" Height="200"
                        Padding="26,24"
                        Cursor="Hand" MouseLeftButtonUp="Recycle_Click"
                        ToolTip="Покажу, что лежит в корзине, и вынесу.">
                    <StackPanel VerticalAlignment="Center" Margin="0">
                        <Border Background="{DynamicResource B_Soft}" CornerRadius="16" Width="60" Height="60"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                       Foreground="{DynamicResource B_Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Корзина" FontFamily="{DynamicResource F_Ui}" FontSize="17"
                                   Foreground="{DynamicResource B_Text}" Margin="0,14,0,0"/>
                        <TextBlock x:Name="RecycleSub" Text="Смотрю…" FontSize="13"
                                   Foreground="{DynamicResource B_Dim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 🆕 0.14.3: чат и история — компактные ссылки под сеткой.
                 Дом = 4 кнопки-цепочки (спека PROJECT), функции не теряются. -->
            <StackPanel Orientation="Horizontal" Margin="8,16,0,0">
                <TextBlock x:Name="CardChat" Text="Спросить помощника →"
                           FontFamily="{DynamicResource F_Ui}" FontSize="14"
                           Foreground="{DynamicResource B_Accent}"
                           TextDecorations="Underline" Cursor="Hand"
                           MouseLeftButtonUp="Chat_Click"
                           ToolTip="Спроси словами — подскажу и сделаю (нужен флаг «Экспериментальное»)."/>
                <TextBlock x:Name="CardHistory" Text="Что я сделал →"
                           FontFamily="{DynamicResource F_Ui}" FontSize="14"
                           Foreground="{DynamicResource B_Accent}"
                           TextDecorations="Underline" Cursor="Hand"
                           Margin="24,0,0,0"
                           MouseLeftButtonUp="History_Click"
                           ToolTip="История: все действия, что подтверждены."/>
            </StackPanel>

            <TextBlock Text="Всё спрашивает подтверждения. Что сделано — видно в «Что я сделал»."
                       FontSize="13" Foreground="{DynamicResource B_Dim}"
                       Margin="8,20,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Нужно больше возможностей? → Расширенный режим"
                       FontSize="13" Foreground="{DynamicResource B_Accent}"
                       Margin="8,12,0,0" TextWrapping="Wrap" Cursor="Hand"
                       TextDecorations="Underline" MouseLeftButtonUp="GoAdvanced_Click"
                       ToolTip="Открыть Настройки на блоке «Вид»."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>


