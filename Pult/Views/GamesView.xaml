<UserControl x:Class="Pult.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="24,20,24,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Игры" FontFamily="{DynamicResource F_Ui}"
                               FontSize="15" Foreground="{DynamicResource B_Text}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountText" Text="" FontSize="12"
                               Foreground="{DynamicResource B_Muted}"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshBtn" Content="Обновить" MinWidth="110" Height="34"
                            Cursor="Hand" Background="{DynamicResource B_Accent}"
                            Foreground="White" BorderThickness="0" Click="Refresh_Click"
                            ToolTip="Пересканировать все источники: Steam, ярлыки, папки."/>
                    <Border x:Name="SizesGap" Width="8"/>
                    <Button x:Name="SizesBtn" Content="Размеры" MinWidth="110" Height="34"
                            Cursor="Hand" Background="{DynamicResource B_Tile}"
                            Foreground="{DynamicResource B_Text}"
                            BorderBrush="{DynamicResource B_BorderH}" BorderThickness="2"
                            Click="Sizes_Click" ToolTip="Посчитать размеры всех игр (долго)."/>
                    <Border x:Name="AddGap" Width="8"/>
                    <Button x:Name="AddFolderBtn" Content="+Папка" MinWidth="110" Height="34"
                            Cursor="Hand" Background="{DynamicResource B_Tile}"
                            Foreground="{DynamicResource B_Text}"
                            BorderBrush="{DynamicResource B_BorderH}" BorderThickness="2"
                            Click="AddFolder_Click" ToolTip="Добавить свою папку с играми (с любого диска)."/>
                    <Border Width="8"/>
                    <Button x:Name="RandomBtn" Content="Случайная" MinWidth="110" Height="34"
                            Cursor="Hand" Background="{DynamicResource B_Tile}"
                            Foreground="{DynamicResource B_Text}"
                            BorderBrush="{DynamicResource B_BorderH}" BorderThickness="2"
                            Click="Random_Click" ToolTip="Не знаешь во что поиграть — выберу за тебя."/>
                </StackPanel>
            </Grid>

            <!-- Хиро-статистика: чипы считаются в Render(), в Простом скрыты. -->
            <StackPanel x:Name="HeroRow" Orientation="Horizontal" Margin="0,16,0,0"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Height="34"
                         Background="{DynamicResource B_Tile}" Foreground="{DynamicResource B_Text}"
                         BorderBrush="{DynamicResource B_Border}" BorderThickness="2"
                         VerticalContentAlignment="Center" Padding="10,0"
                         ToolTip="Фильтр по названию. Клик по карточке — запуск игры."
                         TextChanged="SearchBox_TextChanged"/>
                <Button x:Name="SortNameBtn" Grid.Column="1" Content="Имя" MinWidth="100" Height="34"
                        Margin="8,0,0,0" Cursor="Hand" Background="{DynamicResource B_Tile}"
                        Foreground="{DynamicResource B_Text}"
                        BorderBrush="{DynamicResource B_BorderH}" BorderThickness="2"
                        Click="SortName_Click" ToolTip="Сортировать по имени (повторно — наоборот)."/>
                <Button x:Name="SortSizeBtn" Grid.Column="2" Content="Размер" MinWidth="100" Height="34"
                        Margin="8,0,0,0" Cursor="Hand" Background="{DynamicResource B_Tile}"
                        Foreground="{DynamicResource B_Text}"
                        BorderBrush="{DynamicResource B_BorderH}" BorderThickness="2"
                        Click="SortSize_Click" ToolTip="Сортировать по размеру (повторно — наоборот)."/>
            </Grid>
            <TextBlock Text="Поиск по названию. Клик по карточке — запуск."
                       FontSize="12" Foreground="{DynamicResource B_Muted}"
                       Margin="2,6,0,0"/>

            <TextBlock x:Name="StatusText" Text="Готов" FontSize="12"
                       Foreground="{DynamicResource B_Muted}" Margin="2,8,0,0"/>

            <UniformGrid x:Name="CardsGrid" Columns="3" Margin="0,8,0,0"/>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" Margin="0,48,0,0">
                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                           Foreground="{DynamicResource B_Accent}" HorizontalAlignment="Center"/>
                <TextBlock Text="Игр пока нет" FontFamily="{DynamicResource F_Ui}" FontSize="13"
                           Foreground="{DynamicResource B_Text}" HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
                <TextBlock Text="Нажми «Обновить» или добавь папку с играми кнопкой «+Папка»."
                           FontSize="12" Foreground="{DynamicResource B_Muted}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" x:Name="EmptyHint"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>


