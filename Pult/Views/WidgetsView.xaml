<UserControl x:Class="Pult.Views.WidgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <StackPanel Margin="24,20,24,24" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Виджеты" FontFamily="{DynamicResource F_Ui}"
                       FontSize="15" Foreground="{DynamicResource B_Text}"/>
            <TextBlock Text="Мини-панель на рабочий стол: часы, CPU, RAM. Таскается мышью."
                       FontSize="12" Foreground="{DynamicResource B_Muted}"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>

            <Border Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Border}"
                    BorderThickness="2" CornerRadius="0" Padding="20,16" Margin="0,16,0,0">
                <StackPanel>
                    <!-- 🆕 0.14.3: у этой секции состояния нет — полоса
                         тихая (B_Border); в Минимуме гаснет как в Настройках. -->
                    <Border x:Name="WStrip" Background="{DynamicResource B_Bar}" Height="2" Width="200"
                            HorizontalAlignment="Center" Margin="0,-14,0,12"/>
                    <TextBlock x:Name="WidgetState" Text="Скрыт"
                               FontFamily="{DynamicResource F_Ui}" FontSize="11"
                               Foreground="{DynamicResource B_Text}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ToggleBtn" Content="Показать" MinWidth="140" Height="36"
                                Click="Toggle_Click"/>
                        <Border Width="8"/>
                        <Button Content="Сбросить позицию" MinWidth="170" Height="36"
                                Click="Reset_Click"
                                ToolTip="Вернуть виджет в правый верхний угол."/>
                    </StackPanel>
                    <CheckBox x:Name="TopmostBox" Content="Поверх всех окон"
                              Margin="0,12,0,0"
                              Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
