<UserControl x:Class="Pult.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pult"
             SizeChanged="Root_SizeChanged"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>

        <!-- Bento-карточка экрана: квадрат, рамка 2px, ховер — плитка с рамкой
             подсветки. ClipToBounds держит заливки и accent-блики внутри карточки. -->
        <Style x:Key="SysCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B_Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_TileH}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource B_BorderH}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Hairline: волосяная линия под шапкой страницы и секциями карточек -->
        <Style x:Key="Hair" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource B_Border}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Мини-карточка процесса: ховер-подсветка через триггер -->
        <Style x:Key="ProcCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B_Tile}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_Border}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource B_BorderH}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">

        <StackPanel Margin="24,20,24,24">

            <!-- ================= Шапка страницы ================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Система" FontFamily="{DynamicResource F_Ui}"
                               FontSize="15" Foreground="{DynamicResource B_Text}"/>
                    <!-- Живая строка свежести данных: тикает без лишнего таймера,
                         штамп ставит полное обновление (см. StampFresh/TickFresh) -->
                    <TextBlock x:Name="FreshText" Text="обновлено…" FontSize="11"
                               Foreground="{DynamicResource B_Dim}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Что здесь что?" Height="32" Padding="12,0"
                            Click="Help_Click" ToolTip="Простыми словами: что показывает каждая плашка."/>
                    <Button Content="Обновить" MinWidth="140" Height="32" Margin="8,0,0,0"
                            Click="Refresh_Click" ToolTip="Обновить все данные."/>
                </StackPanel>
            </Grid>

            <!-- Тонкий разделитель hairline под шапкой: акцентная волосяная полоска -->
            <Border Background="{DynamicResource B_Bar}" Height="1" Margin="0,14,0,0"/>

            <Border x:Name="ExpBanner" Background="{DynamicResource B_Soft}"
                    BorderBrush="{DynamicResource B_Accent}" BorderThickness="1"
                    CornerRadius="0" Padding="12,8" Margin="0,12,0,0"
                    Visibility="Collapsed">
                <TextBlock Text="Кнопки действий включаются флагом «Экспериментальное»: Настройки → Вид → Интерфейс «Расширенный», затем галочка."
                           FontSize="12" Foreground="{DynamicResource B_Dim}" TextWrapping="Wrap"/>
            </Border>

            <!-- ================= Hero-строка KPI (бенто сверху) =================
                 Четыре плитки «приборной панели» — БЕЗ колец, арок и кругов:
                 асимметрия 1.4*/*/*/* (CPU шире), огромное значение цвета зоны
                 здоровья, подзаголовок F_Ui, статическая рулетка-измеритель
                 с волосяными засечками, суб-подпись и статичный accent-блик 2px
                 по верхнему краю. Значения/заливки/цвета кладёт KpiHeroPaint()
                 мгновенно, без единой анимации. -->
            <Grid x:Name="HeroRow" Margin="0,16,0,-12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Процессор -->
                <Border Grid.Column="0" Style="{StaticResource SysCard}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Статичный accent-блик 64px по верхнему краю плитки -->
                        <Border Grid.Row="0" x:Name="KpiCpuBlip" Width="64" Height="2"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="-20,-16,0,0"/>

                        <TextBlock Grid.Row="1" x:Name="KpiCpuPct" Text="–"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="36"
                                   Foreground="{DynamicResource B_Text}"
                                   HorizontalAlignment="Left" Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="2" Text="Процессор"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="13"
                                   Foreground="{DynamicResource B_Muted}"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>

                        <!-- Рулетка-измеритель: трек B_Tile 5px, заливка PaintLeds
                             (пара cpu, мгновенно), засечки — волосяные B_BorderH
                             по осям 10/30/50/70/90% -->
                        <Border Grid.Row="3" Background="{DynamicResource B_Tile}"
                                Height="5" ClipToBounds="True" Margin="0,10,0,0">
                            <Grid>
                                <Grid x:Name="KpiCpuBar"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="1" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="2" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="3" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="4" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="4" x:Name="KpiCpuSub" Text="—" FontSize="11"
                                   FontFamily="{DynamicResource F_Ui}"
                                   Foreground="{DynamicResource B_Muted}" TextWrapping="Wrap"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Память -->
                <Border Grid.Column="1" Style="{StaticResource SysCard}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" x:Name="KpiRamBlip" Width="64" Height="2"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="-20,-16,0,0"/>

                        <TextBlock Grid.Row="1" x:Name="KpiRamPct" Text="–"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="36"
                                   Foreground="{DynamicResource B_Text}"
                                   HorizontalAlignment="Left" Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="2" Text="Память"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="13"
                                   Foreground="{DynamicResource B_Muted}"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>

                        <Border Grid.Row="3" Background="{DynamicResource B_Tile}"
                                Height="5" ClipToBounds="True" Margin="0,10,0,0">
                            <Grid>
                                <Grid x:Name="KpiRamBar"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="1" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="2" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="3" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="4" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="4" x:Name="KpiRamSub" Text="—" FontSize="11"
                                   FontFamily="{DynamicResource F_Ui}"
                                   Foreground="{DynamicResource B_Muted}" TextWrapping="Wrap"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Диск -->
                <Border Grid.Column="2" Style="{StaticResource SysCard}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" x:Name="KpiDiskBlip" Width="64" Height="2"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="-20,-16,0,0"/>

                        <TextBlock Grid.Row="1" x:Name="KpiDiskPct" Text="–"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="36"
                                   Foreground="{DynamicResource B_Text}"
                                   HorizontalAlignment="Left" Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="2" Text="Диск"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="13"
                                   Foreground="{DynamicResource B_Muted}"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>

                        <Border Grid.Row="3" Background="{DynamicResource B_Tile}"
                                Height="5" ClipToBounds="True" Margin="0,10,0,0">
                            <Grid>
                                <Grid x:Name="KpiDiskBar"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="1" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="2" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="3" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="4" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="4" x:Name="KpiDiskSub" Text="—" FontSize="11"
                                   FontFamily="{DynamicResource F_Ui}"
                                   Foreground="{DynamicResource B_Muted}" TextWrapping="Wrap"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Сеть -->
                <Border Grid.Column="3" Style="{StaticResource SysCard}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" x:Name="KpiNetBlip" Width="64" Height="2"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="-20,-16,0,0"/>

                        <TextBlock Grid.Row="1" x:Name="KpiNetPct" Text="–"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="36"
                                   Foreground="{DynamicResource B_Text}"
                                   HorizontalAlignment="Left" Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="2" Text="Сеть"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="13"
                                   Foreground="{DynamicResource B_Muted}"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>

                        <Border Grid.Row="3" Background="{DynamicResource B_Tile}"
                                Height="5" ClipToBounds="True" Margin="0,10,0,0">
                            <Grid>
                                <Grid x:Name="KpiNetBar"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="1" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="2" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="3" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="4" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="4" x:Name="KpiNetSub" Text="—" FontSize="11"
                                   FontFamily="{DynamicResource F_Ui}"
                                   Foreground="{DynamicResource B_Muted}" TextWrapping="Wrap"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 🆕 0.14.3: строка «первые две секунды» — только критичное:
                 температура, место на диске, ошибки журнала. Цвет точки и
                 подписи = состояние (зелёный ок / жёлтый внимание / красный
                 критично); чип ошибок кликабелен — раскрывает журнал. -->
            <StackPanel x:Name="ChipsRow" Orientation="Horizontal" Margin="0,14,0,0">
                <Border x:Name="ChipTemp" Background="{DynamicResource B_Tile}"
                        BorderBrush="{DynamicResource B_Border}" BorderThickness="1"
                        Padding="12,7" Margin="0,0,10,0" Visibility="Collapsed"
                        ToolTip="Температура процессора. Критично с 65 °C, внимание с 50 °C.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ChipTempDot" Width="8" Height="8" Margin="0,0,9,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource B_Muted}"/>
                        <TextBlock x:Name="ChipTempText" Text="—" FontSize="13"
                                   FontFamily="{DynamicResource F_Ui}"
                                   Foreground="{DynamicResource B_Text}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ChipDisk" Background="{DynamicResource B_Tile}"
                        BorderBrush="{DynamicResource B_Border}" BorderThickness="1"
                        Padding="12,7" Margin="0,0,10,0" Visibility="Collapsed"
                        ToolTip="Свободно на системном диске. Мало места — внимание с 80% занятости.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ChipDiskDot" Width="8" Height="8" Margin="0,0,9,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource B_Muted}"/>
                        <TextBlock x:Name="ChipDiskText" Text="—" FontSize="13"
                                   FontFamily="{DynamicResource F_Ui}"
                                   Foreground="{DynamicResource B_Text}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ChipErr" Background="{DynamicResource B_Tile}"
                        BorderBrush="{DynamicResource B_Border}" BorderThickness="1"
                        Padding="12,7" Cursor="Hand" MouseLeftButtonUp="GoErrors_Click"
                        ToolTip="Свежие ошибки журналов. Клик — открыть список.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ChipErrDot" Width="8" Height="8" Margin="0,0,9,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource B_Muted}"/>
                        <TextBlock x:Name="ChipErrText" Text="Проверяю…" FontSize="13"
                                   FontFamily="{DynamicResource F_Ui}"
                                   Foreground="{DynamicResource B_Text}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= Чипы-вкладки ================= -->
            <StackPanel x:Name="TabBar" Orientation="Horizontal" Margin="0,16,0,0">

                <Button Tag="overview" Content="Обзор" Height="34" Padding="14,0" Margin="0,0,8,0"
                        Click="Tab_Click"/>

                <Button Tag="perf" Content="Скорость" Height="34" Padding="14,0" Margin="0,0,8,0"
                        Click="Tab_Click" ToolTip="Процессы, автозагрузка, службы."/>

                <Button Tag="storage" Content="Хранилище" Height="34" Padding="14,0" Margin="0,0,8,0"
                        Click="Tab_Click" ToolTip="Папки, программы, мусор."/>

                <Button Tag="privacy" Content="Твики" Height="34" Padding="14,0" Margin="0,0,8,0"
                        Click="Tab_Click" ToolTip="Приватность и твики."/>

                <Button Tag="hw" Content="Железо" Height="34" Padding="14,0" Margin="0,0,8,0"
                        Click="Tab_Click" ToolTip="Железо, датчики, драйверы, звук."/>

                <Button Tag="net" Content="Сеть" Height="34" Padding="14,0"
                        Click="Tab_Click" ToolTip="Адаптеры, Wi-Fi, подключения."/>

            </StackPanel>

            <!-- ================= Приборная стена (бенто-плитки Обзора) ===============
                 Плитки, футер «сеть» и ящик деталей собираются в code-behind
                 (BentoLayout/BentoPaint): узлы ниже — контейнеры под наполнение
                 из тех же данных, что и карточки. Виден ТОЛЬКО на «Обзоре»:
                 HeroRow/чипы/колонки карточек на вкладке отключаются. -->
            <StackPanel x:Name="BentoPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <!-- Ряды плиток: по Grid на ряд, колонки — звёзды по спанам -->
                <StackPanel x:Name="BentoRows"/>

                <!-- Футер «сеть»: подпись метрики, значение и рулетка net -->
                <Border x:Name="BentoFooter" Style="{StaticResource SysCard}" Padding="16,11"
                        Margin="0,12,0,0" Cursor="Hand"
                        MouseLeftButtonUp="Tile_Click" Tag="load"
                        ToolTip="Скорость сети. Клик — подробности внизу.">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="230"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="СЕТЬ" FontSize="11"
                                   FontFamily="{DynamicResource F_Ui}"
                                   Foreground="{DynamicResource B_Muted}"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="1" x:Name="BentoNetText" Text="—"
                                   FontSize="13" FontFamily="{DynamicResource F_Ui}"
                                   Foreground="{DynamicResource B_Text}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Grid Grid.Column="2" x:Name="BentoNetBar" Height="5"
                              VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Ящик деталей: раскрытая карточка под стеной -->
                <Border x:Name="BentoDrawer" Style="{StaticResource SysCard}" Padding="16,13"
                        Margin="0,12,0,4" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="BentoDrawerTitle" Text="" FontSize="12"
                                   FontFamily="{DynamicResource F_Ui}"
                                   Foreground="{DynamicResource B_Muted}" Margin="0,0,0,6"/>
                        <StackPanel x:Name="BentoDrawerHost"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= Сетка карточек =================
                 Раскладку колонок пересобирает ApplyLayout ( код-behind ):
                 2 колонки — 1.6fr / 1fr (широкая «приборная» часть + рельс
                 статусов), 3 колонки на очень широких окнах. Порядок карточек
                 в колонках = порядок в CardWeights, не переставлять! -->
            <Grid x:Name="LayoutGrid" Margin="0,12,0,0">

                <!-- Стартовые ширины = типичный 2-колоночный bento (1.6fr/1fr),
                     средняя колонка нулевой: до первого ApplyLayout нет дыры
                     посреди экрана. ApplyLayout пересобирает это под режим окна. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Средняя колонка для широкого экрана -->
                <StackPanel x:Name="MidColumn" Grid.Column="1" VerticalAlignment="Top"
                            Margin="6,0,6,0" Visibility="Collapsed"/>

                <!-- Левая колонка: Загрузка, Драйверы, Службы, Сеть, Мониторы,
                     Приватность, Мусор, Питание (порядок = CardWeights!).
                     ApplyLayout только переливает детей между колонками —
                     сами карточки отсюда не пропадают. -->
                <StackPanel x:Name="LeftColumn" Grid.Column="0" VerticalAlignment="Top"
                            Margin="0,0,6,0">

                <!-- Загрузка: приборная панель — процессор, память, диски, сеть -->
                <Border x:Name="LoadCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock Text="Загрузка" FontFamily="{DynamicResource F_Ui}"
                                   FontSize="12" Foreground="{DynamicResource B_Text}"/>
                        <!-- 🆕 0.14.3: полоса-статус секции вместо нейтрального
                             hairline: цвет = худшая зона (процессор/память/диск). -->
                        <Border x:Name="StripLoad" Height="2" Margin="0,10,0,0"
                                Background="{DynamicResource B_Border}"/>

                        <!-- Секция «Процессор»: подпись-секция с hairline + процент
                             справа (F_Ui), контекст строкой, бар, топ-3 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Процессор" FontSize="12"
                                       FontFamily="{DynamicResource F_Ui}"
                                       Foreground="{DynamicResource B_Muted}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource Hair}"
                                    Margin="8,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="CpuPctText" Text="–"
                                       FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                       Foreground="{DynamicResource B_Text}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="CpuInfoLine" Text="—" FontSize="11"
                                   Foreground="{DynamicResource B_Dim}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <!-- Рулетка-измеритель: трек B_Tile 5px + засечки B_BorderH -->
                        <Border Background="{DynamicResource B_Tile}"
                                Height="5" ClipToBounds="True" Margin="0,10,0,0">
                            <Grid>
                                <Grid x:Name="CpuBarGrid"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="1" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="2" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="3" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="4" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Топ-3 процесса с мини-барами: трек B_Soft, заливка парой "cpu" -->
                        <StackPanel x:Name="TopProcsPanel" Margin="0,8,0,0"/>

                        <!-- Секция «Память»: сегментная полоса (занято ярко,
                             свободно приглушённо — PaintLeds c dimTail) -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Память" FontSize="12"
                                       FontFamily="{DynamicResource F_Ui}"
                                       Foreground="{DynamicResource B_Muted}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource Hair}"
                                    Margin="8,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="RamPctText" Text="–"
                                       FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                       Foreground="{DynamicResource B_Text}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Рулетка-измеритель памяти: трек B_Tile + засечки -->
                        <Border Background="{DynamicResource B_Tile}"
                                Height="5" ClipToBounds="True" Margin="0,10,0,0">
                            <Grid>
                                <Grid x:Name="RamBarGrid"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="1" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="2" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="3" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                    <Border Grid.Column="4" Width="1"
                                            Background="{DynamicResource B_BorderH}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="RamSubText" FontSize="11"
                                   Foreground="{DynamicResource B_Muted}" Margin="0,5,0,0"/>

                        <!-- Секция «Диски»: строки per-disk строит BuildDisks,
                             чип-температура справа — из датчиков (DisksTempChip) -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Диски" FontSize="12"
                                       FontFamily="{DynamicResource F_Ui}"
                                       Foreground="{DynamicResource B_Muted}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource Hair}"
                                    Margin="8,0,8,0" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="{DynamicResource B_Soft}"
                                    BorderBrush="{DynamicResource B_Border}" BorderThickness="1"
                                    Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="DisksTempChip" Text="—" FontSize="11"
                                           Foreground="{DynamicResource B_Muted}"/>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="DisksPanel" Margin="0,6,0,0"/>

                        <!-- Секция «Сеть»: живая строка + спарклайн столбиков
                             (NetSparkGrid строит код из кольцевого буфера) -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Сеть" FontSize="12"
                                       FontFamily="{DynamicResource F_Ui}"
                                       Foreground="{DynamicResource B_Muted}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource Hair}"
                                    Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="NetworkLiveText" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <Border Background="{DynamicResource B_Soft}"
                                BorderBrush="{DynamicResource B_Border}" BorderThickness="1"
                                Height="44" Margin="0,6,0,0">
                            <Grid x:Name="NetSparkGrid" Margin="4,4"/>
                        </Border>

                        <!-- Батарея: на десктопе код сам прячет оба элемента -->
                        <StackPanel x:Name="BatteryHeader" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="&#xEB50;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource B_Dim}" VerticalAlignment="Center"/>
                            <TextBlock Text="Батарея" FontSize="12"
                                       FontFamily="{DynamicResource F_Ui}"
                                       Foreground="{DynamicResource B_Muted}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="BatteryText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource B_Text}" Margin="0,4,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Драйверы -->
                <Border x:Name="DriversCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="DriversTitle" Text="Драйверы"
                                       FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                       Foreground="{DynamicResource B_Text}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Скан" Height="26" Padding="10,0" FontSize="11"
                                        Cursor="Hand" Click="DrvScan_Click"
                                        ToolTip="Пересканировать устройства (pnputil)."/>
                                <Button Content="Диспетчер" Height="26" Padding="10,0" FontSize="11"
                                        Margin="6,0,0,0" Cursor="Hand" Click="DrvMgr_Click"
                                        ToolTip="Открыть диспетчер устройств."/>
                                <Button Content="Обновления" Height="26" Padding="10,0" FontSize="11"
                                        Margin="6,0,0,0" Cursor="Hand" Click="DrvUpdate_Click"
                                        ToolTip="Открыть Центр обновления Windows."/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="DriversPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Службы -->
                <Border x:Name="ServicesCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="ServicesTitle" Text="Службы"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="ServicesPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Сеть (адаптеры) -->
                <Border x:Name="AdaptersCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="AdaptersTitle" Text="Сеть"
                                       FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                       Foreground="{DynamicResource B_Text}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Подключения" Height="26" Padding="10,0" FontSize="11"
                                        Cursor="Hand" Click="NetConn_Click"
                                        ToolTip="Сетевые подключения (ncpa.cpl)."/>
                                <Button Content="Пинг" Height="26" Padding="10,0" FontSize="11"
                                        Margin="6,0,0,0" Cursor="Hand" Click="Ping_Click"
                                        ToolTip="Проверить интернет: пинг 8.8.8.8."/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="AdaptersPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Мониторы -->
                <Border x:Name="MonitorsCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="MonitorsTitle" Text="Мониторы"
                                       FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                       Foreground="{DynamicResource B_Text}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Экран" Height="26" Padding="10,0"
                                    FontSize="11" Cursor="Hand" Click="Display_Click"
                                    ToolTip="Параметры экрана."/>
                        </Grid>

                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="MonitorsPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Приватность -->
                <Border x:Name="PrivacyCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="PrivacyTitle" Text="Приватность"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>

                        <TextBlock Text="Что не отдаём Microsoft и приложениям. Кнопки — только с флагом."
                                   FontSize="11" Foreground="{DynamicResource B_Muted}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <StackPanel x:Name="PrivacyPanel" Margin="0,8,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Мусор -->
                <Border x:Name="JunkCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="JunkTitle" Text="Мусор"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>

                        <TextBlock Text="Встроенные приложения Windows. Удаление — только с флагом."
                                   FontSize="11" Foreground="{DynamicResource B_Muted}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <StackPanel x:Name="JunkPanel" Margin="0,8,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Питание: правый рельс статусов на вкладке «Обзор» -->
                <Border x:Name="PowerCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="PowerTitle" Text="Питание"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <!-- 🆕 0.14.3: полоса-статус секции: заряд/сеть/критичный
                             заряд; нейтраль — батареи нет или данных ещё нет. -->
                        <Border x:Name="StripPower" Height="2" Margin="0,10,0,0"
                                Background="{DynamicResource B_Border}"/>
                        <StackPanel x:Name="PowerPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                </StackPanel>

                <!-- Правая колонка: Железо, Процессы, Автозагрузка,
                     Папки, Программы, Датчики, Wi-Fi, Подключения, Звук,
                     Папки системы, Обновления, Ошибки, Твики (= CardWeights) -->
                <StackPanel x:Name="RightColumn" Grid.Column="2" VerticalAlignment="Top"
                            Margin="6,0,0,0">

                <!-- Железо -->
                <Border x:Name="HwCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock Text="Железо" FontFamily="{DynamicResource F_Ui}"
                                   FontSize="12" Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>

                        <StackPanel x:Name="MainHwPanel" Margin="0,10,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Сведения о системе" Height="30" Padding="12,0"
                                    FontSize="12" Cursor="Hand" Click="Msinfo_Click"
                                    ToolTip="Сведения о системе (msinfo32)."/>
                            <Button x:Name="DetailsButton" Content="Подробнее" MinWidth="140"
                                    Height="30" Margin="8,0,0,0" Cursor="Hand"
                                    Click="Details_Click" ToolTip="Показать детали железа."/>
                        </StackPanel>

                        <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,12,0,0">

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource B_Dim}" VerticalAlignment="Center"/>
                                <TextBlock Text="Процессор" FontSize="12" Margin="22,0,0,0"
                                           FontFamily="{DynamicResource F_Ui}"
                                           Foreground="{DynamicResource B_Muted}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="CpuDetailText" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource B_Text}" Margin="0,2,0,10"/>

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="&#xE754;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource B_Dim}" VerticalAlignment="Center"/>
                                <TextBlock Text="Видео" FontSize="12" Margin="22,0,0,0"
                                           FontFamily="{DynamicResource F_Ui}"
                                           Foreground="{DynamicResource B_Muted}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="GpuDetailText" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource B_Text}" Margin="0,2,0,10"/>

                            <StackPanel x:Name="DrivesSection">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource B_Dim}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Накопители" FontSize="12" Margin="22,0,0,0"
                                               FontFamily="{DynamicResource F_Ui}"
                                               Foreground="{DynamicResource B_Muted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel x:Name="DrivesDetailPanel" Margin="0,2,0,10"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource B_Dim}" VerticalAlignment="Center"/>
                                <TextBlock Text="Сеть" FontSize="12" Margin="22,0,0,0"
                                           FontFamily="{DynamicResource F_Ui}"
                                           Foreground="{DynamicResource B_Muted}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="NetworkText" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource B_Text}" Margin="0,2,0,10"/>

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource B_Dim}" VerticalAlignment="Center"/>
                                <TextBlock Text="Система" FontSize="12" Margin="22,0,0,0"
                                           FontFamily="{DynamicResource F_Ui}"
                                           Foreground="{DynamicResource B_Muted}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel x:Name="SysDetailPanel" Margin="0,2,0,0"/>

                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Процессы -->
                <Border x:Name="ProcsCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Процессы"
                                       FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                       Foreground="{DynamicResource B_Text}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ProcMemBtn" Content="Память" Height="26"
                                        Padding="10,0" FontSize="11" Cursor="Hand"
                                        Click="ProcMode_Click" Tag="mem"
                                        ToolTip="Топ процессов по памяти."/>
                                <Button x:Name="ProcCpuBtn" Content="CPU" Height="26"
                                        Padding="10,0" FontSize="11" Margin="6,0,0,0"
                                        Cursor="Hand" Click="ProcMode_Click" Tag="cpu"
                                        ToolTip="Топ процессов по CPU."/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>

                        <TextBlock x:Name="ProcsHint" FontSize="11"
                                   Foreground="{DynamicResource B_Muted}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>

                        <StackPanel x:Name="ProcsPanel" Margin="0,8,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Автозагрузка -->
                <Border x:Name="StartupCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="StartupTitle" Text="Автозагрузка"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="StartupPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Папки -->
                <Border x:Name="FoldersCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="FoldersTitle" Text="Папки"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="FoldersPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Программы -->
                <Border x:Name="ProgramsCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="ProgramsTitle" Text="Программы"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="ProgramsPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Датчики -->
                <Border x:Name="SensorsCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="SensorsTitle" Text="Датчики"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="SensorsPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Wi-Fi -->
                <Border x:Name="WifiCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="WifiTitle" Text="Wi-Fi"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="WifiPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Подключения (TCP) -->
                <Border x:Name="TcpCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="TcpTitle" Text="Подключения"
                                       FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                       Foreground="{DynamicResource B_Text}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="TcpToggle" Content="—" Height="26"
                                    Padding="10,0" FontSize="11" Cursor="Hand"
                                    Click="Collapse_Click" Tag="TcpPanel"
                                    ToolTip="Свернуть/развернуть список."/>
                        </Grid>

                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="TcpPanel" Margin="0,10,0,0" Visibility="Collapsed"/>

                    </StackPanel>
                </Border>

                <!-- Звук -->
                <Border x:Name="AudioCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="AudioTitle" Text="Звук"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="AudioPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Папки системы -->
                <Border x:Name="SysFoldersCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="SysFoldersTitle" Text="Папки системы"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="SysFoldersPanel" Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Обновления -->
                <Border x:Name="UpdatesCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="UpdatesTitle" Text="Обновления"
                                       FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                       Foreground="{DynamicResource B_Text}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Проверить" Height="26" Padding="10,0"
                                    FontSize="11" Cursor="Hand" Click="WuScan_Click"
                                    ToolTip="Запустить проверку обновлений Windows."/>
                        </Grid>

                        <!-- 🆕 0.14.3: полоса-статус секции: жёлтая — есть
                             ожидающие обновления, красная — нужен ребут,
                             зелёная — всё свежее, нейтраль — ещё не проверено. -->
                        <Border x:Name="StripUpdates" Height="2" Margin="0,10,0,0"
                                Background="{DynamicResource B_Border}"/>
                        <StackPanel x:Name="UpdatesPanel" Margin="0,10,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBox x:Name="WingetBox" Width="220" Height="30"
                                     VerticalContentAlignment="Center"/>

                            <Button Content="Установить" Height="30" Padding="12,0" FontSize="12"
                                    Margin="8,0,0,0" Cursor="Hand" Click="WingetInstall_Click"
                                    ToolTip="Установить пакет через winget."/>

                            <Button Content="Обновить всё" Height="30" Padding="12,0" FontSize="12"
                                    Margin="8,0,0,0" Cursor="Hand" Click="WingetUpgrade_Click"
                                    ToolTip="Обновить все программы. Долго!"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Ошибки -->
                <Border x:Name="EventsCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="EventsTitle" Text="Ошибки"
                                       FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                       Foreground="{DynamicResource B_Text}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="EventsToggle" Content="+" Height="26"
                                    Padding="10,0" FontSize="11" Cursor="Hand"
                                    Click="Collapse_Click" Tag="EventsPanel"
                                    ToolTip="Показать/скрыть список."/>
                        </Grid>

                        <!-- 🆕 0.14.3: полоса-статус секции: красная — есть
                             свежие ошибки, зелёная — журнал чистый. -->
                        <Border x:Name="StripEvents" Height="2" Margin="0,10,0,0"
                                Background="{DynamicResource B_Border}"/>
                        <!-- 🆕 0.14.3: превью свёрнутого журнала — видно, критично
                             или нет, не раскрывая список (фидбек 0.14.2). -->
                        <TextBlock x:Name="EventsPreview" FontFamily="{DynamicResource F_Ui}"
                                   FontSize="11" Foreground="{DynamicResource B_Muted}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <StackPanel x:Name="EventsPanel" Margin="0,10,0,0" Visibility="Collapsed"/>

                    </StackPanel>
                </Border>

                <!-- Твики -->
                <Border x:Name="TweaksCard" Style="{StaticResource SysCard}">
                    <StackPanel>

                        <TextBlock x:Name="TweaksTitle" Text="Твики"
                                   FontFamily="{DynamicResource F_Ui}" FontSize="12"
                                   Foreground="{DynamicResource B_Text}"/>
                        <Border Style="{StaticResource Hair}" Margin="0,10,0,0"/>

                        <TextBlock Text="Полезные настройки Windows в один клик. Осторожно: точка восстановления не помешает."
                                   FontSize="11" Foreground="{DynamicResource B_Muted}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <StackPanel x:Name="TweaksPanel" Margin="0,8,0,0"/>

                    </StackPanel>
                </Border>

                </StackPanel>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</UserControl>
