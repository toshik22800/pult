<Application x:Class="Pult.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Pult.Services"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Палитра (тёмная, из питон-версии) -->
        <Color x:Key="C_Bg">#0A0E1A</Color>
        <Color x:Key="C_Panel">#0E1424</Color>
        <Color x:Key="C_Border">#1C2340</Color>
        <Color x:Key="C_BorderH">#2A3050</Color>
        <Color x:Key="C_Text">#E8ECFF</Color>
        <Color x:Key="C_Dim">#B8BEE0</Color>
        <Color x:Key="C_Muted">#7A82A8</Color>
        <Color x:Key="C_Accent">#7C6CF0</Color>
        <Color x:Key="C_Soft">#1E1B3D</Color>
        <Color x:Key="C_Tile">#131829</Color>
        <Color x:Key="C_TileH">#1E2440</Color>
        <Color x:Key="C_Sidebar">#080B16</Color>

        <SolidColorBrush x:Key="B_Bg" Color="{StaticResource C_Bg}"/>
        <SolidColorBrush x:Key="B_Panel" Color="{StaticResource C_Panel}"/>
        <SolidColorBrush x:Key="B_Border" Color="{StaticResource C_Border}"/>
        <SolidColorBrush x:Key="B_BorderH" Color="{StaticResource C_BorderH}"/>
        <SolidColorBrush x:Key="B_Text" Color="{StaticResource C_Text}"/>
        <SolidColorBrush x:Key="B_Dim" Color="{StaticResource C_Dim}"/>
        <SolidColorBrush x:Key="B_Muted" Color="{StaticResource C_Muted}"/>
        <SolidColorBrush x:Key="B_Accent" Color="{StaticResource C_Accent}"/>
        <SolidColorBrush x:Key="B_Soft" Color="{StaticResource C_Soft}"/>
        <SolidColorBrush x:Key="B_Tile" Color="{StaticResource C_Tile}"/>
        <SolidColorBrush x:Key="B_TileH" Color="{StaticResource C_TileH}"/>
        <SolidColorBrush x:Key="B_Sidebar" Color="{StaticResource C_Sidebar}"/>

        <!-- Карточка с глубиной: лёгкий градиент панели вниз к фону.
             ThemeService.ApplyColors перекрашивает стопы под любую тему. -->
        <LinearGradientBrush x:Key="B_Card" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#16192A"/>
            <GradientStop Offset="1" Color="#0C111F"/>
        </LinearGradientBrush>
        <!-- Акцентный блик-полоска над карточками: цвет темы, гаснет вправо -->
        <LinearGradientBrush x:Key="B_Bar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FF7C6CF0"/>
            <GradientStop Offset="1" Color="#00000000"/>
        </LinearGradientBrush>

        <!-- Пиксельный шрифт (кириллица есть). Ретро-начертание: при
             FontKey=retro ApplyFont ставит F_Ui сюда — весь интерфейс
             становится пиксельным. -->
        <FontFamily x:Key="F_Pixel">./Fonts/#Press Start 2P</FontFamily>
        <!-- Material Icons (Apache 2.0): профессиональные иконки, включая молнию -->
        <FontFamily x:Key="F_Icon">./Fonts/#Material Icons</FontFamily>
        <!-- Основной шрифт интерфейса: переключается в Настройках (Вид, блок «Шрифт»). -->
        <FontFamily x:Key="F_Ui">Segoe UI</FontFamily>

        <!-- Пиксель-сетка: едва видимые точки под контентом -->
        <DrawingBrush x:Key="DotGrid" TileMode="Tile" Viewbox="0,0 28,28" ViewboxUnits="Absolute"
                      Viewport="0,0 28,28" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#151C33"
                    Geometry="M26,26 L28,26 L28,28 L26,28 Z"/>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Кнопки навигации -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource B_Muted}"/>
            <Setter Property="FontFamily" Value="{DynamicResource F_Ui}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <!-- Активный пункт: акцентная полоска-рельс слева -->
                            <Border x:Name="NavInd" Width="3" Opacity="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Background="{DynamicResource B_Accent}"/>
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_TileH}"/>
                    <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Карточка действия: ретро — квадратная, бордер 2px -->
        <Style x:Key="ActionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B_Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_TileH}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Мягкая карточка Простого интерфейса: скруглённая, дружелюбная -->
        <Style x:Key="SimpleActionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B_Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/> <!-- = DesignTokens.CornerSimple; x:Static сюда нельзя: double в Setter не конвертируется в CornerRadius -->
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_TileH}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ================= Ретро-контролы (применяются везде) ================= -->

        <!-- Подсказки -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource B_Tile}"/>
            <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B_BorderH}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Кнопки по умолчанию: тёмная плашка, квадрат, мгновенный ховер -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource B_Tile}"/>
            <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_TileH}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_Soft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Поля ввода: собственный тёмный шаблон. Системный хром (белая
             подложка) исключён при любой теме; фокус — акцентная рамка и
             подсветка фона, ховер — рамка ярче. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource B_Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource B_Accent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource B_Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="BorderBrush"
                                        Value="{DynamicResource B_BorderH}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PART_Border" Property="BorderBrush"
                                        Value="{DynamicResource B_Accent}"/>
                                <Setter Property="Background" Value="{DynamicResource B_Soft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Элементы выпадающих списков -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource B_Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_TileH}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_Soft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Выпадающие списки: тёмные целиком, включая popup -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource B_Tile}"/>
            <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Foreground="{DynamicResource B_Text}" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="▾" FontSize="12"
                                                           Foreground="{DynamicResource B_Muted}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="{DynamicResource B_Panel}"
                                        BorderBrush="{DynamicResource B_BorderH}" BorderThickness="2"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource B_BorderH}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Чекбоксы: квадратный бокс -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18"
                                    Background="{DynamicResource B_Panel}"
                                    BorderBrush="{DynamicResource B_BorderH}" BorderThickness="2">
                                <TextBlock x:Name="Mark" Text="✕" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource B_Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Списки -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource B_Tile}"/>
            <Setter Property="Foreground" Value="{DynamicResource B_Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_TileH}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_Soft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Тонкий оверлей-скроллбар (ключевой стиль — применяется явно) -->
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Opacity="0.4">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar" Background="{DynamicResource B_BorderH}"
                                                        BorderThickness="0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Background"
                                                                Value="{DynamicResource B_Accent}"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0"
                                                  Focusable="False" IsTabStop="False"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0"
                                                  Focusable="False" IsTabStop="False"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScrollViewer с гарантированным тёмным скроллом (белой полосы не будет) -->
        <Style TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource SlimScrollBar}"
                                       Orientation="Vertical" Width="8"
                                       Margin="0,4,3,4" HorizontalAlignment="Right"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Скроллбары: тонкие тёмные -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource B_BorderH}"
                                           BorderThickness="0"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0"
                                                  Focusable="False" IsTabStop="False"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0"
                                                  Focusable="False" IsTabStop="False"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource B_Panel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
