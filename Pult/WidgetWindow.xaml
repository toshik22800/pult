<Window x:Class="Pult.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pult"
        Title="Пульт — виджет" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonDown="Root_Drag" LocationChanged="Root_Location">
    <Grid x:Name="RootGrid" Margin="14" TextElement.FontFamily="{DynamicResource F_Ui}">
        <!-- Слой 0: заливка + тень под виджетом (текста тут нет) -->
        <Border Background="{DynamicResource B_Panel}" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>
        </Border>
        <!-- Слой 1: размытая тонировка поверх заливки, под контентом -->
        <Border CornerRadius="16" Opacity="0.14" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{DynamicResource C_Accent}"/>
                    <GradientStop Offset="1" Color="Transparent"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <BlurEffect Radius="8"/>
            </Border.Effect>
        </Border>
        <!-- Слой 2: контент, без эффектов — текст чёткий -->
        <StackPanel Margin="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ClockText" Grid.Column="0" Text="--:--"
                           FontFamily="{DynamicResource F_Ui}" FontSize="36"
                           Foreground="{DynamicResource B_Text}" Margin="0,0,0,0" LineHeight="36"/>
                <Button Grid.Column="1" Content="✕" Width="26" Height="26" FontSize="11"
                        VerticalAlignment="Top" Click="Close_Click"
                        ToolTip="Скрыть виджет (вернуть: вкладка «Виджеты»).">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <TextBlock x:Name="DateText" Text="" FontFamily="{DynamicResource F_Ui}" FontSize="10"
                       Foreground="{DynamicResource B_Dim}" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Grid Width="72" Height="72">
                        <local:Ring x:Name="CpuRing" Value="0" Segments="24"
                                    Track="{DynamicResource B_BorderH}" Fill="{DynamicResource B_Accent}"
                                    Thickness="7"/>
                        <TextBlock x:Name="CpuPct" Text="–" FontFamily="{DynamicResource F_Ui}" FontSize="11"
                                   Foreground="{DynamicResource B_Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource B_Muted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Grid Width="72" Height="72">
                        <local:Ring x:Name="RamRing" Value="0" Segments="24"
                                    Track="{DynamicResource B_BorderH}" Fill="{DynamicResource B_Accent}"
                                    Thickness="7"/>
                        <TextBlock x:Name="RamPct" Text="–" FontFamily="{DynamicResource F_Ui}" FontSize="11"
                                   Foreground="{DynamicResource B_Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="RAM" FontSize="11" Foreground="{DynamicResource B_Muted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <Grid Width="72" Height="72">
                        <local:Ring x:Name="DiskRing" Value="0" Segments="24"
                                    Track="{DynamicResource B_BorderH}" Fill="{DynamicResource B_Accent}"
                                    Thickness="7"/>
                        <TextBlock x:Name="DiskPct" Text="–" FontFamily="{DynamicResource F_Ui}" FontSize="11"
                                   Foreground="{DynamicResource B_Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Диск" FontSize="11" Foreground="{DynamicResource B_Muted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        <!-- Слой 3: чёткая рамка поверх всего -->
        <Border Background="Transparent" BorderBrush="{DynamicResource B_Border}"
                BorderThickness="2" CornerRadius="16" IsHitTestVisible="False"/>
    </Grid>
</Window>
