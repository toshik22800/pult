<Window x:Class="Pult.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение" Width="440" SizeToContent="Height"
        MinHeight="200" MaxWidth="520"
        Background="{DynamicResource B_Border}"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Topmost="True"
        AllowsTransparency="True"
        ShowInTaskbar="False">
    <Grid TextElement.FontFamily="{DynamicResource F_Ui}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource B_Bg}"
                BorderBrush="{DynamicResource B_Border}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Titlebar_Drag">
            <Grid Margin="8,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Подтверждение" FontFamily="{DynamicResource F_Ui}"
                           FontSize="9" Foreground="{DynamicResource B_Dim}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="36" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource B_Muted}" Cursor="Hand"
                        Click="No_Click"/>
            </Grid>
        </Border>
        <Border x:Name="BodyBorder" Grid.Row="1" Background="{DynamicResource B_Bg}" Margin="1,0,1,1"
                Padding="24,18,24,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource B_Tile}" Width="52" Height="52"
                            BorderBrush="{DynamicResource B_BorderH}" BorderThickness="1">
                        <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="24" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource B_Accent}"/>
                    </Border>
                    <TextBlock x:Name="QuestionLabel" FontFamily="{DynamicResource F_Ui}"
                               FontSize="12" Foreground="{DynamicResource B_Text}"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               TextWrapping="Wrap" MaxWidth="300"/>
                </StackPanel>
                <Border Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Border}"
                        BorderThickness="1" Padding="12,10" Margin="0,14,0,0"
                        Visibility="Collapsed" x:Name="DetailsBox">
                    <TextBlock x:Name="DetailsLabel" FontFamily="Consolas" FontSize="12"
                               Foreground="{DynamicResource B_Dim}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Нет" MinWidth="110" Height="38" Cursor="Hand"
                            Background="{DynamicResource B_Tile}" Foreground="{DynamicResource B_Text}"
                            BorderBrush="{DynamicResource B_BorderH}" BorderThickness="1"
                            Click="No_Click"/>
                    <Border Width="10"/>
                    <Button Content="Да" MinWidth="110" Height="38" Cursor="Hand"
                            Background="{DynamicResource B_Accent}" Foreground="White"
                            BorderThickness="0" Click="Yes_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>


